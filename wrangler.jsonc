{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teddmhen",
  "account_id": "5bc39a497fcb8a2a7226ef898e94d3e3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "teddmhen.piotrzmudadev.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teddmhen",
      "database_id": "cf0ed80a-c36b-42de-ab9b-b1e7dac8008b",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
}
